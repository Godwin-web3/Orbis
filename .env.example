ENGINE_MODE=dry-run

# Live broadcast (Sepolia only) — guarded by EXECUTION_ACK + EXECUTION_PRIVATE_KEY
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
TARGET_CONTRACT=0x8Ad8867126e7F541f6a16609B8263D043d6647f4
MINT_FUNCTION=publicMint
MINT_QUANTITY=1
EXECUTION_PRIVATE_KEY=
EXECUTION_ACK=

# EIP-7702 batch execution: address of the deployed batch-delegate contract for /mint-all
BATCH_EXECUTOR_ADDRESS=

# Multi-user custodial relay: comma-separated funded bot-wallet private keys.
# Each /mint routes an NFT to the requesting user's /register-ed address, paid for
# by a fleet wallet. Users need no private key and no wallet.
FLEET_PRIVATE_KEYS=
# Where registered user -> receive-address mappings are persisted
USER_REGISTRY_PATH=data/users.jsonl

# Non-custodial execution (recommended for public): no keys needed. /sign builds
# the exact transaction, /submit relays the user-signed raw tx. The backend never
# holds a private key.

# Autonomous per-user auto-mint (opt-in, OFF by default): any chat can run
# /autokey <burner-privatekey> then /auto on to have the bot sign and broadcast
# policy-approved free mints for THEIR OWN wallet automatically, with no /mint
# needed. Keys are encrypted at rest with AES-256-GCM using this key. Leave unset
# to disable the feature entirely (auto* commands will say so). Generate with:
#   openssl rand -hex 32
AUTO_MINT_ENCRYPTION_KEY=
AUTO_MINT_KEYSTORE_PATH=data/automint-keys.jsonl
AUTO_MINT_LOG_PATH=data/automint-log.jsonl
AUTO_MINT_SCAN_INTERVAL_MS=120000
# Safety caps so an unattended loop can't run away while you're not watching
AUTO_MINT_MAX_PER_USER_PER_SCAN=1
AUTO_MINT_MAX_TOTAL_PER_SCAN=10
# Auto-mint also requires the operator's /ack on guard, same as manual /mint.

DISCOVERY_MODE=contracts
CONFIRMATIONS=2
BASE_CONTRACTS=
CANDIDATE_LOG=data/candidates.jsonl
EVENT_LOG=data/events.jsonl
ENABLED_CHAINS=base
BASE_RPC_URL=
ETHEREUM_RPC_URL=
SEPOLIA_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
POLYGON_RPC_URL=
ROBINHOOD_RPC_URL=
BASE_CONTRACTS=
ARBITRUM_CONTRACTS=
OPTIMISM_CONTRACTS=
POLYGON_CONTRACTS=
ROBINHOOD_CONTRACTS=
ETHEREUM_CONTRACTS=
CANDIDATE_LOG_PATH=runtime/candidates.jsonl
EVENT_LOG_PATH=runtime/events.jsonl
PREPARED_LOG=data/prepared-transactions.jsonl
SIMULATION_FROM=
EXECUTION_PRIVATE_KEY=
EXECUTION_ACK=
MAX_GAS_NATIVE=0.005
MIN_EXPECTED_VALUE_NATIVE=0
MAX_MINTS_PER_OPPORTUNITY=1
# Telegram command bot (create a bot via @BotFather, then copy its token)
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user/chat IDs allowed to control the bot
TELEGRAM_ADMIN_IDS=
TELEGRAM_CHAT_ID=
# Where the bot persists the on/off execution guard
GUARD_STATE_PATH=data/guard.json
EXPLORER_API_URL=
EXPLORER_API_KEY=
CLAIM_DATA_API=
CLAIM_DATA_API_TOKEN=
TESTNET_RPC_URL=
TESTNET_CHAIN_KEY=base
TESTNET_CONTRACT=
TESTNET_MINT_FUNCTION=mint
TESTNET_MINT_ARGS=
TESTNET_FROM=
TESTNET_REPORT=data/testnet-probe.json

# Optional single-contract read-only testnet probe
TESTNET_CHAIN_KEY=base
TESTNET_RPC_URL=
TESTNET_CONTRACT=
TESTNET_FROM=
TESTNET_MINT_FUNCTION=
TESTNET_MINT_ARGS=
TESTNET_REPORT=data/testnet-probe.json

# Serverless deployment only (worker/index.ts, Cloudflare Workers + Supabase) — see the
# "Serverless deployment" section of the README. Not used by scripts/telegram-bot.ts.
# These are set as `wrangler secret put` values / wrangler.toml [vars], not this .env file.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_WEBHOOK_SECRET=
WORKER_URL=
